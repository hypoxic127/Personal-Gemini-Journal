# Local development only. Production values are injected by Cloud Run --set-secrets.
# No BOM, no real values: dotenv reads a UTF-8 BOM as part of the first key name, which
# would silently turn NODE_ENV into an unset variable and drop the server into development mode.
NODE_ENV=development

# 8080 matches Cloud Run. The Firestore emulator deliberately runs on 8085 (firebase.json)
# so `pnpm dev` and `pnpm test:rules` cannot collide.
PORT=8080

GCP_PROJECT_ID=

# Secrets — Secret Manager in production, never committed with a value.
GEMINI_API_KEY=
MAPS_SERVER_API_KEY=
MAPS_BROWSER_API_KEY=

# Firebase Web config: a public identifier, not a credential (protected by Firestore
# Rules + App Check). Served at runtime by GET /api/config/public so nothing is inlined
# at build time. Required in production — the server refuses to start without them.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
# Optional; defaults to ${GCP_PROJECT_ID}.firebaseapp.com
FIREBASE_AUTH_DOMAIN=
