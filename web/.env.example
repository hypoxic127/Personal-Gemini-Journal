# Firebase Web config — a public identifier, not a credential.
# Optional: leave empty and the SPA fetches the same values at runtime from
# GET /api/config/public, which is how the deployed build works.
# No BOM in this file: dotenv/Vite would fold it into the first key name.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
